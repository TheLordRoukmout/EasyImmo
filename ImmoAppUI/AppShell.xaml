<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ImmoAppUI.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:ImmoAppUI.Views"
    Title="EasyImmo"
    Shell.NavBarIsVisible="False"
    Shell.TabBarBackgroundColor="White"
    Shell.TabBarForegroundColor="#71B73F"
    Shell.TabBarTitleColor="#71B73F"
    Shell.TabBarUnselectedColor="#AAAAAA"
    Shell.TabBarDisabledColor="#CCCCCC">
    
    

    <TabBar>
        <Tab Title="Dashboard">
            <ShellContent ContentTemplate="{DataTemplate views:DashboardPage}"/>
        </Tab>
        <Tab Title="Biens">
            <ShellContent ContentTemplate="{DataTemplate views:BiensPage}"/>
        </Tab>
        <Tab Title="Documents">
            <ShellContent ContentTemplate="{DataTemplate views:DocumentPage}"/>
        </Tab>
        <Tab Title="Calendar">
            <ShellContent ContentTemplate="{DataTemplate views:CalendarPage}"/>
        </Tab>
        <!--<Tab Title="Mail">
            <ShellContent ContentTemplate="{DataTemplate views:MailBoxPage}"/>
        </Tab> -->
        <!--<Tab Title="Profil">
            <ShellContent ContentTemplate="{DataTemplate views:ProfilePage}"/>
        </Tab> -->
    </TabBar>

</Shell>
