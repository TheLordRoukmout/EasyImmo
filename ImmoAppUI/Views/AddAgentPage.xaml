<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ImmoAppUI.Views.AddAgentPage"
             Title="AddAgentPage">
    
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label Text="Username" FontAttributes="Bold"/>
            <Entry x:Name="UsernameEntry" Placeholder="Entrez le username"/>

            <Label Text="Mot de passe" FontAttributes="Bold"/>
            <Entry x:Name="PasswordEntry" Placeholder="Entrez le mot de passe" IsPassword="True"/>

            <Label Text="Email" FontAttributes="Bold"/>
            <Entry x:Name="EmailEntry" Placeholder="Entrez l'email" Keyboard="Email"/>

            <Label Text="Téléphone" FontAttributes="Bold"/>
            <Entry x:Name="PhoneEntry" Placeholder="Entrez le téléphone" Keyboard="Telephone"/>

            <Label Text="Date d'engagement" FontAttributes="Bold"/>
            <DatePicker x:Name="HireDatePicker"/>

            <Button Text="Créer l'agent"
                    BackgroundColor="#42A5F5"
                    TextColor="White"
                    Clicked="OnCreateAgentClicked"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>