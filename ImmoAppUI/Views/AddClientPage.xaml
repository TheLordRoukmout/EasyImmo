<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ImmoAppUI.Views.AddClientPage"
             Title="AddClientPage">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label Text="Lastname" FontAttributes="Bold"/>
            <Entry x:Name="LastnameEntry" Placeholder="Entrez le nom de famille"/>

            <Label Text="Firstname" FontAttributes="Bold"/>
            <Entry x:Name="FirstnameEntry" Placeholder="Entrez le prénom"/>

            <Label Text="Email" FontAttributes="Bold"/>
            <Entry x:Name="EmailEntry" Placeholder="Entrez l'email" Keyboard="Email"/>

            <Label Text="Phone" FontAttributes="Bold"/>
            <Entry x:Name="PhoneEntry" Placeholder="Entrez le n° de téléphone" Keyboard="Telephone"/>

            <Label Text="Address" FontAttributes="Bold"/>
            <Entry x:Name="AddressEntry" Placeholder="Entrez l'adresse du client"/>

            <Label Text="TypeClient" FontAttributes="Bold"/>
            <Entry x:Name="TypeClientEntry" Placeholder="Quel est le type du client"/>

            <Button Text="Créer le client"
                BackgroundColor="#71B73F"
                TextColor="White"
                Clicked="OnCreateClientClicked"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>