<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ImmoAppUI.Views.CalendarPage"
             Title="Calendrier">

    <Grid RowDefinitions="Auto, Auto, *" Padding="20" RowSpacing="10">

        <!-- Navigation mois -->
        <HorizontalStackLayout Grid.Row="0" HorizontalOptions="Center" Spacing="20">
            <Button Text="◀" BackgroundColor="#71B73F" TextColor="White"
                    CornerRadius="20" WidthRequest="40" HeightRequest="40"
                    Clicked="OnPreviousMonthClicked"/>
            <Label Text="{Binding MonthLabel}" FontSize="22" 
                   FontAttributes="Bold" TextColor="#71B73F"
                   VerticalOptions="Center"/>
            <Button Text="▶" BackgroundColor="#71B73F" TextColor="White"
                    CornerRadius="20" WidthRequest="40" HeightRequest="40"
                    Clicked="OnNextMonthClicked"/>
        </HorizontalStackLayout>

        <!-- Header jours de la semaine -->
        <Grid Grid.Row="1" ColumnDefinitions="*, *, *, *, *, *, *" ColumnSpacing="5">
            <Label Grid.Column="0" Text="Lun" HorizontalOptions="Center" 
                   FontAttributes="Bold" TextColor="#71B73F"/>
            <Label Grid.Column="1" Text="Mar" HorizontalOptions="Center" 
                   FontAttributes="Bold" TextColor="#71B73F"/>
            <Label Grid.Column="2" Text="Mer" HorizontalOptions="Center" 
                   FontAttributes="Bold" TextColor="#71B73F"/>
            <Label Grid.Column="3" Text="Jeu" HorizontalOptions="Center" 
                   FontAttributes="Bold" TextColor="#71B73F"/>
            <Label Grid.Column="4" Text="Ven" HorizontalOptions="Center" 
                   FontAttributes="Bold" TextColor="#71B73F"/>
            <Label Grid.Column="5" Text="Sam" HorizontalOptions="Center" 
                   FontAttributes="Bold" TextColor="#71B73F"/>
            <Label Grid.Column="6" Text="Dim" HorizontalOptions="Center" 
                   FontAttributes="Bold" TextColor="#71B73F"/>
        </Grid>

        <!-- Grille des jours -->
        <ScrollView Grid.Row="2">
            <CollectionView ItemsSource="{Binding Days}">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="7" 
                                     HorizontalItemSpacing="5" VerticalItemSpacing="5"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeShape="RoundRectangle 8"
                                Stroke="#CCCCCC"
                                MinimumHeightRequest="80"
                                Margin="2">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsToday}" Value="True">
                                    <Setter Property="BackgroundColor" Value="#E8F5E9"/>
                                    <Setter Property="Stroke" Value="#71B73F"/>
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding IsEmpty}" Value="True">
                                    <Setter Property="BackgroundColor" Value="Transparent"/>
                                    <Setter Property="Stroke" Value="Transparent"/>
                                </DataTrigger>
                            </Border.Triggers>
                            <VerticalStackLayout Padding="5" Spacing="3">
                                <!-- Numéro du jour -->
                                <Label Text="{Binding DayNumber}" 
                                       FontAttributes="Bold"
                                       FontSize="14"
                                       HorizontalOptions="End">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsToday}" Value="True">
                                            <Setter Property="TextColor" Value="#71B73F"/>
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsEmpty}" Value="True">
                                            <Setter Property="IsVisible" Value="False"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>

                                <!-- Événements du jour -->
                                <CollectionView ItemsSource="{Binding Events}">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Border BackgroundColor="#71B73F" StrokeShape="RoundRectangle 5" Margin="0,1" Padding="4,2">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer CommandParameter="{Binding IdEstate}" Tapped="OnEventTapped"/>
                                                </Border.GestureRecognizers>
                                                <VerticalStackLayout Spacing="1">
                                                    <Label Text="{Binding IdTypeEventNavigation.Label}"
                                                        FontSize="9" TextColor="White" FontAttributes="Bold"/>
                                                    <Label Text="{Binding IdEstateNavigation.Reference}"
                                                        FontSize="9" TextColor="White"/>
                                                    <Label Text="{Binding IdAgentNavigation.IdUserNavigation.Username}"
                                                        FontSize="9" TextColor="White"/>
                                                </VerticalStackLayout>
                                            </Border>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>

                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </ScrollView>

    </Grid>

</ContentPage>