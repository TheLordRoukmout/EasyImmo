<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ImmoAppUI.Views.DocumentPage"
             Title="DocumentPage">

    <Grid RowDefinitions="Auto, *" Padding="20" RowSpacing="20">

        <!-- Titre -->
        <Label Grid.Row="0" Text="Gestion" FontSize="24" FontAttributes="Bold"/>

        <!-- 3 cartes cliquables -->
        <HorizontalStackLayout Grid.Row="1" Spacing="20">

            <!-- Carte Agents -->
            <Border BackgroundColor="#E3F2FD" 
                    StrokeShape="RoundRectangle 10"
                    WidthRequest="200" HeightRequest="200">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAgentsTapped"/>
                </Border.GestureRecognizers>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center">
                    <Label Text="Agents" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>

            <!-- Carte Clients -->
            <Border BackgroundColor="#E8F5E9" 
                    StrokeShape="RoundRectangle 10"
                    WidthRequest="200" HeightRequest="200">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnClientsTapped"/>
                </Border.GestureRecognizers>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center">
                    <Label Text="Clients" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>

            <!-- Carte Documents -->
            <Border BackgroundColor="#FFF3E0" 
                    StrokeShape="RoundRectangle 10"
                    WidthRequest="200" HeightRequest="200">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDocumentsTapped"/>
                </Border.GestureRecognizers>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center">
                    <Label Text="Documents" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>

        </HorizontalStackLayout>

    </Grid>
    
</ContentPage>