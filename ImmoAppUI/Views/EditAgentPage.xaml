<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ImmoAppUI.Views.EditAgentPage"
             Title="Modifier un agent">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="15">

            <Label Text="Modifier l'agent" FontSize="24" 
                   FontAttributes="Bold" TextColor="#71B73F"/>

            <!-- Username -->
            <Label Text="Username" FontAttributes="Bold"/>
            <Entry x:Name="UsernameEntry" Placeholder="Username"/>

            <!-- Email -->
            <Label Text="Email" FontAttributes="Bold"/>
            <Entry x:Name="EmailEntry" Placeholder="Email" Keyboard="Email"/>

            <!-- Téléphone -->
            <Label Text="Téléphone" FontAttributes="Bold"/>
            <Entry x:Name="PhoneEntry" Placeholder="Téléphone" Keyboard="Telephone"/>

            <!-- Date d'engagement -->
            <Label Text="Date d'engagement" FontAttributes="Bold"/>
            <DatePicker x:Name="HireDatePicker"/>

            <!-- Actif -->
            <HorizontalStackLayout Spacing="10">
                <Label Text="Actif" FontAttributes="Bold" VerticalOptions="Center"/>
                <Switch x:Name="ActiveSwitch"/>
            </HorizontalStackLayout>

            <!-- Bouton -->
            <Button Text="Modifier l'agent"
                    BackgroundColor="#71B73F"
                    TextColor="White"
                    CornerRadius="10"
                    Margin="0,10,0,0"
                    Clicked="OnUpdateAgentClicked"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>