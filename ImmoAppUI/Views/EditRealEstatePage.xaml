<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ImmoAppUI.Views.EditRealEstatePage"
             Title="Modifier un bien">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="15">

            <Label Text="Modifier le bien" FontSize="24" 
                   FontAttributes="Bold" TextColor="#71B73F"/>

            <!-- Titre -->
            <Label Text="Titre" FontAttributes="Bold"/>
            <Entry x:Name="TitleEntry" Placeholder="Titre du bien"/>

            <!-- Adresse -->
            <Label Text="Adresse" FontAttributes="Bold"/>
            <Entry x:Name="AddressEntry" Placeholder="Adresse"/>

            <!-- Ville -->
            <Label Text="Ville" FontAttributes="Bold"/>
            <Entry x:Name="CityEntry" Placeholder="Ville"/>

            <!-- Code postal -->
            <Label Text="Code postal" FontAttributes="Bold"/>
            <Entry x:Name="PostalCodeEntry" Placeholder="Code postal" Keyboard="Numeric"/>

            <!-- Prix -->
            <Label Text="Prix (€)" FontAttributes="Bold"/>
            <Entry x:Name="PriceEntry" Placeholder="Prix" Keyboard="Numeric"/>

            <!-- Surface -->
            <Label Text="Surface (m²)" FontAttributes="Bold"/>
            <Entry x:Name="SurfaceEntry" Placeholder="Surface" Keyboard="Numeric"/>

            <!-- Description -->
            <Label Text="Description" FontAttributes="Bold"/>
            <Editor x:Name="DescriptionEditor"
                    Placeholder="Description du bien..."
                    HeightRequest="120"/>

            <!-- Bouton -->
            <Button Text="Modifier le bien"
                    BackgroundColor="#71B73F"
                    TextColor="White"
                    CornerRadius="10"
                    Margin="0,10,0,0"
                    Clicked="OnUpdateEstateClicked"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>