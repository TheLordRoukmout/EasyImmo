<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ImmoAppUI.Views.ManagePhotosPage"
             Title="Gérer les photos">

    <Grid RowDefinitions="Auto, *, Auto" Padding="20" RowSpacing="15">

        <!-- Titre -->
        <Label Grid.Row="0" Text="Photos du bien" 
               FontSize="24" FontAttributes="Bold" TextColor="#71B73F"/>

        <!-- Liste des photos -->
        <CollectionView Grid.Row="1" ItemsSource="{Binding Images}">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="3" 
                                 HorizontalItemSpacing="10" VerticalItemSpacing="10"/>
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border StrokeShape="RoundRectangle 10" Stroke="#CCCCCC" Margin="5">
                        <Grid RowDefinitions="150, Auto">
                            <Image Grid.Row="0" Source="{Binding ImagePath}"
                                   Aspect="AspectFill" HeightRequest="150"/>
                            <HorizontalStackLayout Grid.Row="1" Spacing="5" Padding="5">
                                <Button Text="⭐ Principal"
                                        BackgroundColor="#71B73F"
                                        TextColor="White"
                                        FontSize="11"
                                        CornerRadius="5"
                                        CommandParameter="{Binding IdImage}"
                                        Clicked="OnSetMainClicked"/>
                                <Button Text="🗑️"
                                        BackgroundColor="#EF5350"
                                        TextColor="White"
                                        CornerRadius="5"
                                        CommandParameter="{Binding IdImage}"
                                        Clicked="OnDeleteImageClicked"/>
                            </HorizontalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Bouton Ajouter -->
        <Button Grid.Row="2" Text="+ Ajouter une photo"
                BackgroundColor="#71B73F"
                TextColor="White"
                CornerRadius="10"
                Clicked="OnAddPhotoClicked"/>

    </Grid>

</ContentPage>